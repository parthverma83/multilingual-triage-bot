# Copy this file to .env and fill in your values.
# Never commit .env to git.

APP_NAME=MedRoute AI
APP_VERSION=1.0.0

# Set to the Cloudflare URL printed by Cell 7 in Sarvam_Inference_Server.ipynb
# This changes every Colab session — update it each time you restart Colab.
MODEL_PROVIDER=colab
MODEL_ENDPOINT=https://YOUR-CLOUDFLARE-URL.trycloudflare.com
MODEL_API_KEY=

# MySQL (optional — only needed if database logging is enabled)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=triage_db
